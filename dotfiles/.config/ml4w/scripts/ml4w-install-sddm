#!/usr/bin/env bash

# shellcheck source=/dev/null
source "$HOME/.config/ml4w/scripts/ml4w-platform"

if ! command -v gum >/dev/null 2>&1; then
    echo "Error: 'gum' is not installed. Please install gum first."
    exit 1
fi

CONFLICTING_DMS="gdm lightdm lxdm xdm mdm slim wdm"
LOCALBASE="${LOCALBASE:-/usr/local}"
THEME_CACHE_DIR="$HOME/.cache/ml4w-tmp"

if command -v pacman >/dev/null 2>&1; then
    DISTRO="Arch Linux"
    SDDM_CONF_FILE="/etc/sddm.conf.d/ml4w.conf"
    SDDM_THEME_ROOT="/usr/share/sddm/themes"
    INSTALL_PACKAGES=(sddm qt6-svg qt6-virtualkeyboard qt6-multimedia-ffmpeg)
    PKG_CHECK_CMD=(pacman -Qi sddm)
    USE_FREEBSD_RC="false"
elif command -v dnf >/dev/null 2>&1; then
    DISTRO="Fedora"
    SDDM_CONF_FILE="/etc/sddm.conf.d/ml4w.conf"
    SDDM_THEME_ROOT="/usr/share/sddm/themes"
    INSTALL_PACKAGES=(sddm qt6-qtsvg qt6-qtvirtualkeyboard qt6-qtmultimedia)
    PKG_CHECK_CMD=(rpm -q sddm)
    USE_FREEBSD_RC="false"
elif command -v zypper >/dev/null 2>&1; then
    DISTRO="openSUSE Tumbleweed"
    SDDM_CONF_FILE="/etc/sddm.conf.d/ml4w.conf"
    SDDM_THEME_ROOT="/usr/share/sddm/themes"
    INSTALL_PACKAGES=(sddm-qt6 libQt6Svg6 qt6-virtualkeyboard qt6-virtualkeyboard-imports qt6-multimedia qt6-multimedia-imports)
    PKG_CHECK_CMD=(rpm -q sddm)
    USE_FREEBSD_RC="false"
elif ml4w_is_freebsd && command -v pkg >/dev/null 2>&1; then
    DISTRO="FreeBSD"
    SDDM_CONF_FILE="$LOCALBASE/etc/sddm.conf.d/ml4w.conf"
    SDDM_THEME_ROOT="$LOCALBASE/share/sddm/themes"
    PKG_CHECK_CMD=(pkg info -e sddm)
    USE_FREEBSD_RC="true"
    INSTALL_PACKAGES=(sddm)
    for pkg_name in qt6-svg qt6-virtualkeyboard qt6-multimedia; do
        if pkg search -eq "$pkg_name" >/dev/null 2>&1; then
            INSTALL_PACKAGES+=("$pkg_name")
        fi
    done
else
    echo "ERROR: Unsupported package manager"
    exit 1
fi

primarycolor="$(cat ~/.config/ml4w/colors/primary)"
onsurfacecolor="$(cat ~/.config/ml4w/colors/onsurface)"
onprimarycolor="$(cat ~/.config/ml4w/colors/onprimary)"

check_sddm_installed() {
    "${PKG_CHECK_CMD[@]}" >/dev/null 2>&1
}

check_sddm_active() {
    if [[ "$USE_FREEBSD_RC" == "true" ]]; then
        service sddm onestatus >/dev/null 2>&1 || [[ "$(sysrc -n sddm_enable 2>/dev/null)" == "YES" ]]
    else
        systemctl is-active --quiet display-manager
    fi
}

install_sddm() {
    sudo -v
    echo ":: Installing SDDM on $DISTRO..."

    if [[ "$USE_FREEBSD_RC" == "true" ]]; then
        sudo pkg install -y "${INSTALL_PACKAGES[@]}"
    elif command -v pacman >/dev/null 2>&1; then
        sudo pacman -S --noconfirm "${INSTALL_PACKAGES[@]}"
    elif command -v dnf >/dev/null 2>&1; then
        sudo dnf install -y "${INSTALL_PACKAGES[@]}"
    elif command -v zypper >/dev/null 2>&1; then
        sudo zypper install -y "${INSTALL_PACKAGES[@]}"
    else
        echo "ERROR: No supported installer found."
        exit 1
    fi
}

disable_other_dms() {
    local dm

    for dm in $CONFLICTING_DMS; do
        if [[ "$USE_FREEBSD_RC" == "true" ]]; then
            if sysrc -n "${dm}_enable" 2>/dev/null | grep -qi '^yes$'; then
                echo ":: Disabling conflicting DM: $dm..."
                sudo sysrc "${dm}_enable=NO" >/dev/null
            fi
        else
            if systemctl is-enabled --quiet "$dm" 2>/dev/null; then
                echo ":: Disabling conflicting DM: $dm..."
                sudo systemctl disable "$dm"
            fi
        fi
    done
}

activate_sddm() {
    if ! sudo -v; then
        echo "ERROR: Authentication failed. Aborting."
        exit 1
    fi

    disable_other_dms

    if [[ "$USE_FREEBSD_RC" == "true" ]]; then
        echo ":: Enabling SDDM rc service..."
        sudo sysrc sddm_enable=YES >/dev/null
        if sudo service sddm onestart >/dev/null 2>&1; then
            echo ":: SDDM started."
        else
            echo ":: SDDM enabled. Please reboot or start it manually if needed."
        fi
    else
        echo ":: Enabling SDDM Service..."
        if sudo systemctl enable sddm; then
            echo ":: SDDM Service Enabled."
            echo ":: Please reboot your system to apply changes."
        else
            echo "ERROR: Failed to enable SDDM systemd service."
            exit 1
        fi
    fi
}

deactivate_sddm() {
    if ! sudo -v; then
        exit 1
    fi

    echo ":: Deactivating SDDM..."
    if [[ "$USE_FREEBSD_RC" == "true" ]]; then
        sudo sysrc sddm_enable=NO >/dev/null
        sudo service sddm onestop >/dev/null 2>&1 || true
    else
        sudo systemctl disable sddm
    fi
    echo ":: SDDM has been deactivated. You are currently without an active Display Manager."
}

write_theme_config() {
    local theme_dir="$SDDM_THEME_ROOT/ml4w"
    local component_path="$theme_dir/components/"
    local config_body

    config_body=$(cat <<EOF
[Theme]
Current=ml4w

[General]
InputMethod=qtvirtualkeyboard
GreeterEnvironment=QML2_IMPORT_PATH=${component_path},QT_IM_MODULE=qtvirtualkeyboard
EOF
)

    sudo mkdir -p "$(dirname "$SDDM_CONF_FILE")"
    printf '%s\n' "$config_body" | sudo tee "$SDDM_CONF_FILE" >/dev/null
    echo ":: Wrote theme config to $SDDM_CONF_FILE"
}

apply_theme() {
    write_theme_config
}

install_theme() {
    local theme_dir="$SDDM_THEME_ROOT/ml4w"

    echo ":: Starting installation of the ML4W SDDM theme..."
    rm -rf "$THEME_CACHE_DIR"
    mkdir -p "$THEME_CACHE_DIR"

    echo ":: Cloning theme into temporary directory..."
    git clone --depth 1 https://github.com/mylinuxforwork/ml4w-sddm "$THEME_CACHE_DIR/ml4w-sddm"

    echo ":: Copy theme to sddm folder..."
    sudo mkdir -p "$theme_dir"
    sudo cp -Rf "$THEME_CACHE_DIR/ml4w-sddm/." "$theme_dir/"

    apply_theme

    echo ":: Cleaning up..."
    rm -rf "$THEME_CACHE_DIR"
    echo ":: ML4W SDDM theme installed successfully"
}

copy_wallpaper_to_sddm() {
    local wallpaper_path_file="$HOME/.cache/ml4w/hyprland-dotfiles/current_wallpaper"
    local source_wallpaper=""
    local dest_wallpaper="$SDDM_THEME_ROOT/ml4w/backgrounds/ml4w.jpg"
    local mime_type=""
    local temp_jpg="/tmp/current_wallpaper_sddm.jpg"

    echo ":: Copying current wallpaper to SDDM theme background..."

    if ! command -v convert >/dev/null 2>&1; then
        echo "ERROR: 'imagemagick' (convert command) is not installed. Please install it to use this feature."
        return 1
    fi

    if [[ ! -f "$wallpaper_path_file" ]]; then
        echo "ERROR: Wallpaper path file not found at '$wallpaper_path_file'."
        return 1
    fi
    source_wallpaper="$(cat "$wallpaper_path_file")"

    if [[ ! -f "$source_wallpaper" ]]; then
        echo "ERROR: Actual wallpaper file not found at '$source_wallpaper'."
        return 1
    fi

    mime_type="$(file --mime-type -b "$source_wallpaper")"
    if [[ "$mime_type" == "image/jpeg" ]]; then
        cp "$source_wallpaper" "$temp_jpg"
    elif [[ "$mime_type" == "image/png" ]]; then
        echo ":: Converting PNG wallpaper to JPEG..."
        convert "$source_wallpaper" "$temp_jpg" || return 1
    else
        echo "ERROR: Unsupported wallpaper format ($mime_type). Only JPEG and PNG are supported."
        return 1
    fi

    sudo mkdir -p "$(dirname "$dest_wallpaper")"
    sudo cp "$temp_jpg" "$dest_wallpaper"
    rm -f "$temp_jpg"
    echo ":: Wallpaper successfully copied to SDDM theme background."
}

clear
figlet -f smslant "ML4W SDDM"

if ! check_sddm_installed; then
    echo ":: Status: SDDM is NOT installed."
    echo
    if gum confirm --selected.background="$primarycolor" --selected.foreground="$onprimarycolor" --prompt.foreground="$onsurfacecolor" "Do you want to install SDDM?"; then
        install_sddm

        if check_sddm_installed; then
            echo ":: SDDM installed successfully!"

            if gum confirm --selected.background="$primarycolor" --selected.foreground="$onprimarycolor" --prompt.foreground="$onsurfacecolor" "Do you want to activate SDDM now?"; then
                activate_sddm
                echo ":: SDDM activated."
            fi

            if gum confirm --selected.background="$primarycolor" --selected.foreground="$onprimarycolor" --prompt.foreground="$onsurfacecolor" "Install the special ML4W SDDM theme?"; then
                install_theme
            fi
        else
            echo "ERROR: Installation failed."
            exit 1
        fi
    else
        echo ":: Installation cancelled."
        exit 0
    fi
elif ! check_sddm_active; then
    echo ":: SDDM is installed but NOT active."
    echo
    if gum confirm --selected.background="$primarycolor" --selected.foreground="$onprimarycolor" --prompt.foreground="$onsurfacecolor" "Do you want to activate SDDM?"; then
        activate_sddm
        echo ":: SDDM activated."
    fi

    if gum confirm --selected.background="$primarycolor" --selected.foreground="$onprimarycolor" --prompt.foreground="$onsurfacecolor" "Install the special ML4W SDDM theme?"; then
        install_theme
    fi
else
    echo ":: SDDM is installed and active."
    echo
    ACTION=$(gum choose --selected.background="$primarycolor" --selected.foreground="$onprimarycolor" "Install ML4W Theme" "Copy Wallpaper to SDDM" "Deactivate SDDM" "Exit")

    case "$ACTION" in
        "Install ML4W Theme")
            install_theme
            ;;
        "Copy Wallpaper to SDDM")
            copy_wallpaper_to_sddm
            ;;
        "Deactivate SDDM")
            if gum confirm --selected.background="$primarycolor" --selected.foreground="$onprimarycolor" --prompt.foreground="$onsurfacecolor" "Are you sure you want to deactivate SDDM?"; then
                deactivate_sddm
            fi
            ;;
        "Exit")
            exit 0
            ;;
    esac
fi
