#!/usr/bin/env bash

# Default variables
CACHE_FOLDER="$HOME/.cache/ml4w/hyprland-dotfiles"
CACHE_FILE="$CACHE_FOLDER/current_wallpaper"
DEFAULT_WALLPAPER="$HOME/.config/ml4w/wallpapers/default.jpg"
WELCOME_CACHE_DIR="$HOME/.cache/ml4w"
WELCOME_AUTOSTART_DISABLED_FILE="$HOME/.cache/ml4w-welcome-autostart"
WELCOME_SESSION_FILE="$WELCOME_CACHE_DIR/welcome-shown-${HYPRLAND_INSTANCE_SIGNATURE:-default}"

# Colors for UI
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# --- UI Functions (Redirected to stderr) ---
info() { echo -e "${GREEN}[INFO]${NC} $1" >&2; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1" >&2; }
error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

# Ensure that cache folder exists
mkdir -p $HOME/.cache
mkdir -p "$WELCOME_CACHE_DIR"

# Set Wallpaper
mkdir -p $CACHE_FOLDER
if [ ! -f $CACHE_FILE ]; then
    touch $CACHE_FILE
    echo "$DEFAULT_WALLPAPER" > "$CACHE_FILE"
    info "Cache file created"
fi

~/.config/ml4w/scripts/ml4w-wallpaper "$(cat $CACHE_FILE)" &

# Start Quickshell
killall qs
sleep 0.5
qs &
sleep 0.5

# Start ML4W Settings App
PROFILE="com.ml4w.dotfiles" qs -p $HOME/.local/share/ml4w-dotfiles-settings/quickshell &
info "ML4W Dotfiles Settings started"

# Start Quickshell Overview
qs -p $HOME/.config/quickshell/overview &
info "Quickshell Overview started"

# Start ML4W Welcome App
if [ ! -f "$WELCOME_AUTOSTART_DISABLED_FILE" ] && [ ! -f "$WELCOME_SESSION_FILE" ]; then
    touch "$WELCOME_SESSION_FILE"
    sleep 3
    qs ipc call welcome open
    info "ML4W Welcome started"
elif [ -f "$WELCOME_AUTOSTART_DISABLED_FILE" ]; then
    info "ML4W Welcome disabled"
else
    info "ML4W Welcome already shown in this session"
fi
